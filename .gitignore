# Virtual environment
.venv/
venv/
env/

context.md

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Jupyter / notebook checkpoints
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Large / regenerable data files — see README.md "Running the pipeline"
# to regenerate these in a couple of minutes from data/raw/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.parquet
*.npy

# Generated output figures — see README.md to regenerate
results/figures/*
!results/figures/.gitkeep
fig*.png

# Word temporary files
~$*.docx

# Optional: local/editor files
.vscode/
.idea/